{
  "name": "xiaoguanjia-cloudflare",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "astro build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.3.0",
    "astro": "^5.12.0",
    "drizzle-orm": "^0.44.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.24.0"
  }
}
