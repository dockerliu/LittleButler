---
// V2.0 云端账户：登录/注册页（对应 V1.0.1 的本机账户锁屏，PRD 4.7）
import Base from '../layouts/Base.astro';
import { getSession } from '../lib/auth';
import { env } from '../lib/db';

const session = await getSession(env(Astro).KV, Astro);
if (session) return Astro.redirect('/');
---

<Base title="小管家 · 登录">
  <div class="lock">
    <div class="lock-card">
      <div class="lock-logo">¥</div>
      <h1>小管家</h1>
      <p class="lock-sub" id="lock-sub">注册云端账户，随时查看你的账单</p>

      <div class="field">
        <label for="f-username">用户名</label>
        <input id="f-username" type="text" maxlength="16" placeholder="用户名（2–16 位，不含空格）" autocomplete="username" />
      </div>
      <div class="field">
        <label for="f-password">密码</label>
        <input id="f-password" type="password" placeholder="密码（至少 6 位）" autocomplete="current-password" />
      </div>
      <div class="field" id="f-pass2-wrap" hidden>
        <label for="f-password2">确认密码</label>
        <input id="f-password2" type="password" placeholder="再输入一次密码" autocomplete="new-password" />
      </div>
      <label class="lock-remember" id="f-remember-wrap">
        <input id="f-remember" type="checkbox" checked />
        <span>7 天内免登录</span>
      </label>

      <div class="amount-err" id="form-err" style="text-align:center"></div>
      <button class="btn primary wide" id="submit-btn">注 册</button>
      <button class="link-danger" id="mode-switch" style="display:block;width:100%">已有账户？去登录</button>

      <p class="lock-warn" id="lock-warn">
        ⚠ 数据将保存在云端（仅本账户可见）。请务必记住密码：本阶段暂不支持找回密码，遗忘后将无法访问该账户的数据。
      </p>
    </div>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLButtonElement | HTMLElement;
    const errEl = $('form-err') as HTMLElement;
    const submitBtn = $('submit-btn') as HTMLButtonElement;
    const sub = $('lock-sub');
    const pass2Wrap = $('f-pass2-wrap');
    const rememberWrap = $('f-remember-wrap');
    let isRegister = true;

    function setMode(register: boolean) {
      isRegister = register;
      pass2Wrap.hidden = !register;
      rememberWrap.hidden = register; // 注册后固定 7 天免登录，与旧版一致
      sub.textContent = register ? '注册云端账户，随时查看你的账单' : '欢迎回来，请登录云端账户';
      submitBtn.textContent = register ? '注 册' : '登 录';
      errEl.textContent = '';
    }

    $('mode-switch').addEventListener('click', () => setMode(!isRegister));

    async function submit() {
      errEl.textContent = '';
      submitBtn.disabled = true;
      try {
        const username = ($('f-username') as HTMLInputElement).value.trim();
        const password = ($('f-password') as HTMLInputElement).value;
        if (isRegister) {
          const p2 = ($('f-password2') as HTMLInputElement).value;
          if (p2 !== password) { errEl.textContent = '两次输入的密码不一致'; return; }
        }
        const res = await fetch(isRegister ? '/api/auth/register' : '/api/auth/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ username, password, remember: !isRegister ? ($('f-remember') as HTMLInputElement).checked : true }),
        });
        const json = await res.json() as { ok: boolean; msg?: string };
        if (!json.ok) { errEl.textContent = json.msg || '操作失败，请稍后再试'; return; }
        location.href = '/';
      } catch {
        errEl.textContent = '网络异常，请稍后再试';
      } finally {
        submitBtn.disabled = false;
      }
    }

    submitBtn.addEventListener('click', submit);
    for (const id of ['f-password', 'f-password2', 'f-username']) {
      $(id).addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') submit(); });
    }
  </script>
</Base>
